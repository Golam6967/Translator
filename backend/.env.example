# Local Postgres from ../docker-compose.yml (docker compose up -d)
DATABASE_URL=postgresql://acculator:acculator@localhost:5432/acculator
GROQ_API_KEY=gsk_your_key_here
# Gemini fallback for words missing from the local dictionary (get a key at https://aistudio.google.com/apikey)
GOOGLE_GENERATIVE_AI_API_KEY=
# GEMINI_MODEL=gemini-3.8-flash,gemini-3.5-flash,gemini-2.5-flash   (tried in order)
# GROQ_MODEL=openai/gpt-oss-120b

# LLM provider layer: Groq first, Gemini as fallback
LLM_PRIMARY_PROVIDER=groq
LLM_TIMEOUT_MS=20000
# Testing only (ignored when NODE_ENV=production): force the primary to fail
# LLM_FORCE_FAIL_PRIMARY=true
FIREBASE_SERVICE_ACCOUNT_KEY={"type":"service_account","project_id":"..."}
PORT=5000
NODE_ENV=development
