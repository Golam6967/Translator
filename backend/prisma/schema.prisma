// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model User {
  id                 String   @id @default(cuid())
  email              String   @unique
  displayName        String?
  firebaseUid        String?  @unique
  googleId           String?  @unique
  avatar             String?
  language           String   @default("en")
  theme              String   @default("light")
  defaultSourceLang  String   @default("bn")
  fontSize           String   @default("medium")
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  savedTranslations  SavedTranslation[]
  notes              Note[]
  history            History[]

  @@map("users")
}

model SavedTranslation {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  originalText    String   @db.Text
  sourceLang      String
  translations    Json     // { langCode: translatedText }
  tags            String[] @default([])
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@map("saved_translations")
}

model Note {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  title        String
  content      String   @db.Text
  tags         String[] @default([])
  language     String   @default("en")
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt

  @@map("notes")
}

model History {
  id           String   @id @default(cuid())
  userId       String
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  type         String   // "translate", "extract_image", "extract_document", "create_note"
  data         String   @db.Text
  metadata     Json?
  createdAt    DateTime @default(now())

  @@map("history")
}
