    { "id": "s02", "sourceLang": "en", "targetLang": "ar", "sourceText": "Patience is half of faith.", "mustContainTerms": ["sabr", "iman"], "category": "glossary", "notes": "Two terms" },
    { "id": "s03", "sourceLang": "en", "targetLang": "ar", "sourceText": "Prayer is the pillar of religion. Zakat purifies wealth. Patience is the key to relief.", "mustContainTerms": ["salah", "zakat", "sabr"], "category": "glossary", "notes": "Longer multi-sentence input" },
    { "id": "s04", "sourceLang": "en", "targetLang": "ar", "sourceText": "The pilgrimage to Mecca is an obligation for those who are able.", "mustContainTerms": ["hajj"], "category": "glossary", "notes": "Term expressed as a common English word" },
