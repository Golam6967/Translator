    { "id": "s06", "sourceLang": "en", "targetLang": "ur", "sourceText": "Repentance and patience bring mercy.", "mustContainTerms": ["tawbah", "sabr", "rahmah"], "category": "glossary", "notes": "Three terms" },
    { "id": "s07", "sourceLang": "en", "targetLang": "ur", "sourceText": "The mosque is open for the call to prayer.", "mustContainTerms": ["masjid", "adhan"], "category": "glossary", "notes": "Multi-word source form" },
    { "id": "s08", "sourceLang": "en", "targetLang": "ur", "sourceText": "Have trust in God and show gratitude.", "mustContainTerms": ["tawakkul", "shukr"], "category": "glossary", "notes": "Multi-word source form" },
    { "id": "s09", "sourceLang": "en", "targetLang": "tr", "sourceText": "Halal and haram are clear.", "mustContainTerms": ["halal", "haram"], "category": "glossary", "notes": "Terms that stay transliterated" },
    { "id": "s10", "sourceLang": "en", "targetLang": "tr", "sourceText": "Charity does not decrease wealth.", "mustContainTerms": ["sadaqah"], "category": "glossary", "notes": "Hadith-like" },
    { "id": "s11", "sourceLang": "en", "targetLang": "tr", "sourceText": "The Prophet taught mercy and justice.", "mustContainTerms": ["prophet", "rahmah", "adl"], "category": "glossary", "notes": "Three terms" },
    { "id": "s12", "sourceLang": "en", "targetLang": "fa", "sourceText": "Faith and piety lead to paradise.", "mustContainTerms": ["iman", "taqwa", "jannah"], "category": "glossary", "notes": "Three terms" },
    { "id": "s13", "sourceLang": "en", "targetLang": "fa", "sourceText": "Remembrance of God brings peace.\nPatience brings relief.", "mustContainTerms": ["dhikr", "sabr"], "category": "glossary", "notes": "Line break must be preserved" },
    { "id": "s14", "sourceLang": "ar", "targetLang": "en", "sourceText": "الصلاة عماد الدين", "mustContainTerms": ["salah"], "category": "glossary", "notes": "Short proverb-style" },
    { "id": "s15", "sourceLang": "ar", "targetLang": "en", "sourceText": "الصبر مفتاح الفرج", "mustContainTerms": ["sabr"], "category": "idiom", "notes": "Idiom: 'relief' has no single equivalent" },
    { "id": "s16", "sourceLang": "ar", "targetLang": "en", "sourceText": "من صام رمضان إيمانا واحتسابا غفر له ما تقدم من ذنبه", "mustContainTerms": ["ramadan", "iman"], "category": "flag-trigger", "expectFlags": true, "notes": "Hadith; 'ihtisab' is hard to translate and should trigger the scripture notice" },
