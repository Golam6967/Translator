{
  "name": "acculator-backend",
  "version": "1.0.0",
  "description": "Acculator Islamic Translation Companion - Backend",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch --env-file=.env src/index.ts",
    "build": "tsc",
    "start": "node dist/index.js",
    "prisma:migrate": "prisma migrate dev",
    "prisma:studio": "prisma studio",
    "import:dictionary": "tsx src/scripts/importDictionary.ts",
    "import:arabic": "tsx src/scripts/importDictionary.ts arabic",
    "import:persian": "tsx src/scripts/importDictionary.ts persian",
    "import:urdu": "tsx src/scripts/importDictionary.ts urdu",
    "import:turkish": "tsx src/scripts/importDictionary.ts turkish",
    "import:all4": "tsx src/scripts/importDictionary.ts all",
    "import:wikidata": "tsx src/scripts/importWikidata.ts",
    "test:dictionary": "tsx src/scripts/testDictionary.ts"
  },
  "keywords": [],
  "author": "",
  "license": "ISC",
  "dependencies": {
    "@prisma/client": "^5.0.0",
    "better-sqlite3": "^12.11.1",
    "body-parser": "^1.20.2",
    "cors": "^2.8.5",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "firebase-admin": "^11.10.0"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.13",
    "@types/express": "^4.17.23",
    "@types/node": "^22.2.0",
    "prisma": "^5.20.0",
    "tsx": "^4.16.2",
    "typescript": "^5.5.4"
  }
}
